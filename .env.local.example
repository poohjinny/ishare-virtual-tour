# Copy this file to `.env.local` and fill in the key.
# `.env.local.example` is only a template — Vite does not load it.
#
#   Copy-Item .env.local.example .env.local
# Then restart `npm run dev`.

# Ask Guide live chat — server secret for Vite DEV proxy (/__dev/api/ask-guide).
# Never prefix with VITE_ (would leak to the browser bundle).
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
# OPENAI_ASK_GUIDE_MODEL=gpt-4o-mini

# Optional: point the client at Cloudflare Worker (or Azure) Ask Guide API.
# Example after `cd workers/ask-guide && npm run deploy`:
# VITE_ASK_GUIDE_API_URL=https://ishare-ask-guide.<subdomain>.workers.dev/api
# Local Worker: http://127.0.0.1:8787/api
# VITE_ASK_GUIDE_API_URL=
